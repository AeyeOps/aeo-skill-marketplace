{
  "description": "Performance monitoring hook: logs per-tool timing and usage to .claude/performance.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/performance_logger.py || true",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
